generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ───────────────────────────────────────────────
enum Role {
  BUYER
  VENDOR
  CHURCH_ADMIN
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String
  fullName      String
  role          Role     @default(BUYER)
  emailVerified DateTime?
  phoneVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendorProfile VendorProfile?
  churchBranch  ChurchBranch?      @relation("ChurchAdmin")
  cart          Cart?
  orders        Order[]            @relation("BuyerOrders")
  reviews       Review[]
  notifications NotificationEvent[]
  disputes      Dispute[]          @relation("DisputeOpener")

  @@index([role])
}

// ─── Vendor ─────────────────────────────────────────────────
enum VendorStatus {
  PENDING
  VERIFIED
  REJECTED
}

model VendorProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName      String
  slug              String       @unique
  cacNumber         String?
  churchAffiliation String?
  phone             String
  address           String
  city              String
  state             String
  logoUrl           String?
  bannerUrl         String?
  description       String?
  status            VendorStatus @default(PENDING)
  rejectionReason   String?
  products          Product[]
  orders            Order[]
  payouts           Payout[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
}

// ─── Catalog ────────────────────────────────────────────────
model ProductCategory {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  active   Boolean   @default(true)
  products Product[]
}

model Product {
  id           String          @id @default(cuid())
  vendorId     String
  vendor       VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId   String
  category     ProductCategory @relation(fields: [categoryId], references: [id])
  slug         String          @unique
  title        String
  description  String
  priceKobo    Int
  inventoryQty Int             @default(0)
  available    Boolean         @default(true)
  isDigital    Boolean         @default(false)
  weightGrams  Int?
  images       ProductImage[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([vendorId])
  @@index([categoryId])
  @@index([available])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
}

// ─── Cart ───────────────────────────────────────────────────
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  priceKobo Int
  addedAt   DateTime @default(now())

  @@unique([cartId, productId])
}

// ─── Church ─────────────────────────────────────────────────
enum ChurchStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

model ChurchBranch {
  id              String         @id @default(cuid())
  adminUserId     String         @unique
  admin           User           @relation("ChurchAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  churchName      String
  denomination    String
  branchName      String
  slug            String         @unique
  address         String
  city            String
  state           String
  contactPerson   String
  contactPhone    String
  operatingDays   String
  operatingHours  String
  pickupCapacity  Int            @default(50)
  status          ChurchStatus   @default(PENDING)
  rejectionReason String?
  imageUrl        String?
  orders          Order[]
  pickupRecords   PickupRecord[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, state, city])
  @@index([churchName])
}

// ─── Order ──────────────────────────────────────────────────
enum DeliveryType {
  HOME_DELIVERY
  CHURCH_PICKUP
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  ARRIVED_AT_CHURCH
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  FAILED_PICKUP
  CANCELLED
  RETURNED
  DISPUTED
  COMPLETED
}

model Order {
  id               String             @id @default(cuid())
  buyerId          String
  buyer            User               @relation("BuyerOrders", fields: [buyerId], references: [id])
  vendorId         String
  vendor           VendorProfile      @relation(fields: [vendorId], references: [id])
  status           OrderStatus        @default(PENDING_PAYMENT)
  deliveryType     DeliveryType
  deliveryAddress  String?
  deliveryCity     String?
  deliveryState    String?
  churchBranchId   String?
  churchBranch     ChurchBranch?      @relation(fields: [churchBranchId], references: [id])
  pickupCode       String?            @unique
  pickupToken      String?            @unique
  subtotalKobo     Int
  platformFeeKobo  Int
  logisticsFeeKobo Int
  totalKobo        Int
  vendorAmountKobo Int
  paymentId        String?
  payment          Payment?           @relation(fields: [paymentId], references: [id])
  shipment         Shipment?
  pickupRecord     PickupRecord?
  items            OrderItem[]
  dispute          Dispute?
  payout           Payout?
  statusHistory    OrderStatusEvent[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  paidAt           DateTime?
  deliveredAt      DateTime?
  pickedUpAt       DateTime?

  @@index([buyerId, status])
  @@index([vendorId, status])
  @@index([churchBranchId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  title     String
  priceKobo Int
  quantity  Int
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ─── Payment ────────────────────────────────────────────────
enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id               String        @id @default(cuid())
  reference        String        @unique
  provider         String        @default("paystack")
  amountKobo       Int
  platformFeeKobo  Int
  vendorAmountKobo Int
  logisticsFeeKobo Int
  status           PaymentStatus @default(INITIATED)
  rawResponse      Json?
  orders           Order[]
  createdAt        DateTime      @default(now())
  verifiedAt       DateTime?
}

// ─── Shipment ───────────────────────────────────────────────
model Shipment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  externalId  String?
  trackingUrl String?
  quoteKobo   Int
  status      String   @default("created")
  events      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Pickup ─────────────────────────────────────────────────
enum PickupOutcome {
  PENDING
  PICKED_UP
  FAILED
}

model PickupRecord {
  id               String        @id @default(cuid())
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  churchBranchId   String
  churchBranch     ChurchBranch  @relation(fields: [churchBranchId], references: [id])
  arrivedAt        DateTime?
  readyAt          DateTime?
  pickedUpAt       DateTime?
  failedAt         DateTime?
  failureReason    String?
  verifiedByUserId String?
  outcome          PickupOutcome @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([churchBranchId, outcome])
}

// ─── Disputes / Reviews / Payouts / Notifications ───────────
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Dispute {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  openedById  String
  openedBy    User          @relation("DisputeOpener", fields: [openedById], references: [id])
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  rating    Int
  body      String?
  createdAt DateTime @default(now())

  @@unique([productId, authorId])
  @@index([productId])
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  PAID
  FAILED
}

model Payout {
  id         String        @id @default(cuid())
  vendorId   String
  vendor     VendorProfile @relation(fields: [vendorId], references: [id])
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id])
  amountKobo Int
  status     PayoutStatus  @default(PENDING)
  eligibleAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([vendorId, status])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationEventStatus {
  QUEUED
  SENT
  FAILED
}

model NotificationEvent {
  id          String                  @id @default(cuid())
  type        String
  channel     NotificationChannel     @default(IN_APP)
  recipientId String
  recipient   User                    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  payload     Json
  status      NotificationEventStatus @default(QUEUED)
  error       String?
  createdAt   DateTime                @default(now())
  sentAt      DateTime?

  @@index([recipientId, status])
  @@index([type])
}
