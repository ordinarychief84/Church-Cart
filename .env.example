# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/churchcart?schema=public"

# --- Auth ---
JWT_SECRET="change-me-to-a-32-byte-random-string-please"
JWT_ISSUER="churchcart"
COOKIE_NAME="cc_session"
COOKIE_DOMAIN=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Payments (Paystack) ---
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# --- Logistics ---
LOGISTICS_PROVIDER="mock"

# --- Notifications ---
NOTIFICATIONS_EMAIL_PROVIDER="off"
RESEND_API_KEY=""
NOTIFICATIONS_SMS_PROVIDER="off"
NOTIFICATIONS_WHATSAPP_PROVIDER="off"

# --- Platform economics ---
PLATFORM_FEE_BPS="500"
DISPUTE_WINDOW_HOURS="48"
